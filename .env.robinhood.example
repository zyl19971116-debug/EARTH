# Never commit a funded private key. Copy this file outside version control.
ROBINHOOD_DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Official public endpoints. Use a production RPC provider for the live website.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Optional overrides. When omitted, config/robinhood-wallets.json is used.
MAIN_COMMUNITY_WALLET=0xeD370d524dd0A883d7147d6dFdB1F9FE2ec77E26
BUYBACK_RECIPIENT=0xeD370d524dd0A883d7147d6dFdB1F9FE2ec77E26
EARTH_TREASURY=0xeD370d524dd0A883d7147d6dFdB1F9FE2ec77E26

# Must be verified Robinhood Chain addresses. Do not guess these values.
ROBINHOOD_DEX_ROUTER=0xVERIFIED_UNISWAP_V2_COMPATIBLE_ROUTER
ROBINHOOD_WRAPPED_NATIVE=0xVERIFIED_WRAPPED_ETH

GRADUATION_MARKET_CAP_ETH=30
MINIMUM_TRADE_ETH=0.001
BUYBACK_SLIPPAGE_BPS=500
