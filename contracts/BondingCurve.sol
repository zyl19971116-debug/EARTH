pragma solidity ^0.8.24; interface IERC20Lite{function transfer(address,uint256)external returns(bool);function transferFrom(address,address,uint256)external returns(bool);}
contract BondingCurve{uint256 public immutable graduationMarketCap;uint16 public platformFeeBps;uint16 public creatorFeeBps;uint16 public liquidityFeeBps;address public owner;mapping(address=>uint256)public virtualEthReserve;mapping(address=>uint256)public virtualTokenReserve;mapping(address=>bool)public graduated;event Trade(address indexed token,address indexed user,bool buy,uint256 input,uint256 output);constructor(uint256 cap,uint16 p,uint16 c,uint16 l){require(p+c+l<=1000,"fees");graduationMarketCap=cap;platformFeeBps=p;creatorFeeBps=c;liquidityFeeBps=l;owner=msg.sender;}function configure(address token,uint256 ethReserve,uint256 tokenReserve)external{require(msg.sender==owner,"owner");virtualEthReserve[token]=ethReserve;virtualTokenReserve[token]=tokenReserve;}function getBuyPrice(address token,uint256 ethIn)public view returns(uint256){uint256 x=virtualEthReserve[token];uint256 y=virtualTokenReserve[token];return y-(x*y)/(x+ethIn);}function getSellPrice(address token,uint256 tokenIn)public view returns(uint256){uint256 x=virtualEthReserve[token];uint256 y=virtualTokenReserve[token];return x-(x*y)/(y+tokenIn);}function buy(address token)external payable{require(!graduated[token],"graduated");uint256 out=getBuyPrice(token,msg.value);virtualEthReserve[token]+=msg.value;virtualTokenReserve[token]-=out;require(IERC20Lite(token).transfer(msg.sender,out));emit Trade(token,msg.sender,true,msg.value,out);}function sell(address token,uint256 amount)external{require(!graduated[token],"graduated");uint256 out=getSellPrice(token,amount);require(IERC20Lite(token).transferFrom(msg.sender,address(this),amount));virtualTokenReserve[token]+=amount;virtualEthReserve[token]-=out;payable(msg.sender).transfer(out);emit Trade(token,msg.sender,false,amount,out);}function getMarketCap(address token)public view returns(uint256){return virtualEthReserve[token]*2;}function getProgress(address token)external view returns(uint256){uint256 cap=getMarketCap(token);return cap>=graduationMarketCap?100:(cap*100)/graduationMarketCap;}function graduate(address token)external{require(getMarketCap(token)>=graduationMarketCap,"threshold");graduated[token]=true;}}
