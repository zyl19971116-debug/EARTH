pragma solidity ^0.8.24; import "./PointToken.sol";
contract MilestoneToken is PointToken {enum Status{ACTIVE,ACHIEVED,EXPIRED}uint256 public currentValue;uint256 public immutable targetValue;uint64 public immutable deadline;Status public status;address public immutable tracker;event ProgressUpdated(uint256 currentValue,Status status);constructor(string memory n,string memory s,address owner,uint256 current,uint256 target,uint64 end,address updater)PointToken(n,s,owner,1_000_000_000 ether){require(target>0,"target");currentValue=current;targetValue=target;deadline=end;tracker=updater;status=current>=target?Status.ACHIEVED:Status.ACTIVE;}function updateProgress(uint256 value)external{require(msg.sender==tracker,"tracker");require(status==Status.ACTIVE,"closed");currentValue=value;if(value>=targetValue)status=Status.ACHIEVED;else if(deadline>0&&block.timestamp>deadline)status=Status.EXPIRED;emit ProgressUpdated(value,status);}function progress()external view returns(uint256){return currentValue>=targetValue?100:(currentValue*100)/targetValue;}}
